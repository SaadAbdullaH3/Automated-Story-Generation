# Copy to `.env` and fill in only the providers you have keys for.
# Leave them all blank to run in mock/template mode (no internet required).

# WHICH MODEL DOES WHAT lives in config/providers.yaml. This file only holds
# credentials. A provider whose keys are missing is skipped automatically.
#   PROVIDERS_FILE=/path/to/providers.yaml   use a different settings file
#   PROVIDER_IMAGE=placeholder               force one provider for a role
#   LLM_PROVIDER=mock                        force the offline template/keyword path

# --- Google Gemini (free tier, no card) ---------------------------
# https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=

# --- Groq (free tier, no card) ------------------------------------
# https://console.groq.com/keys
# GROQ_API_KEY=

# --- OpenRouter (free tier) ---------------------------------------
# https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# --- Ollama (local models, no key) --------------------------------
# Start `ollama serve`, pull a model, then point the pipeline at it:
# OLLAMA_HOST=http://localhost:11434

# --- OpenAI / Anthropic (paid) ------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- TTS (optional, free fallbacks always available) -------------
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Cloudflare Workers AI (free: 10,000 neurons/day ~ 170 FLUX images) ---
# Account id: dash.cloudflare.com -> Workers & Pages (right-hand sidebar).
# API token:  My Profile -> API Tokens -> Create Token -> Workers AI (read).
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# --- Image generation overrides ----------------------------------
# Pollinations.ai is the default image provider. Without a key it uses the
# legacy keyless endpoint, which serves a weaker model at reduced size.
# A free account key (https://enter.pollinations.ai) unlocks the real models.
# POLLINATIONS_API_KEY=
# POLLINATIONS_MODEL=tongyi-mai/z-image-turbo
# To skip a provider entirely, remove it from config/providers.yaml (or force
# another with PROVIDER_IMAGE=cloudflare).
# SD_API_URL=http://127.0.0.1:7860

# --- Local Stable Diffusion (best for RTX 3050 6GB and similar) --
# Set LOCAL_SD=1 to use the diffusers library directly (in-process).
# Requires CUDA-enabled torch + diffusers; see requirements-local-sd.txt for install
# instructions. Default model is stabilityai/sdxl-turbo (~7 GB, auto-downloads
# on first use). Generates a 768x768 image in ~5-8 s on an RTX 3050.
# LOCAL_SD=1
# LOCAL_SD_MODEL=stabilityai/sdxl-turbo
# LOCAL_SD_STEPS=4

# --- REAL VIDEO GENERATION + LIP SYNC (recommended for best demo) ---
# fal.ai gives ~$1 of free trial credit which is enough for several
# pipelines; it powers BOTH text-to-video (Stable Video Diffusion,
# fast-SVD, CogVideoX) AND lip-sync (SadTalker, sync-lipsync).
# Get a key at https://fal.ai/dashboard/keys
# FAL_KEY=

# Replicate alternative (paid; SVD + Wav2Lip + SadTalker available)
# https://replicate.com/account/api-tokens
# REPLICATE_API_TOKEN=

# Hugging Face Inference API (free tier, lower quality text-to-video)
# https://huggingface.co/settings/tokens
# HF_TOKEN=

# --- Subtitles ----------------------------------------------------
# Every render embeds English + the language chosen in the UI/CLI.
# Add more tracks with a comma-separated list (see shared/languages.py):
# SUBTITLE_EXTRA_LANGUAGES=Urdu,French
# Translation uses the LLM when one is configured, else MyMemory (free,
# ~5,000 chars/day anonymously). An email raises MyMemory to ~50,000/day:
# MYMEMORY_EMAIL=

# --- App config --------------------------------------------------
# HOST=0.0.0.0
# PORT=8000

# --- Where state and assets live (M4) ------------------------------
# Nothing here is required: the default is a SQLite file and local disk,
# which is what `python main.py serve` uses on a laptop.
#
# One database holds the version log and the job queue. Point it at
# Postgres for a real deployment (pip install -r requirements-postgres.txt;
# Neon and Supabase both have a free tier big enough for this):
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/storygen
#
# The API runs a worker thread by default so one command is enough. Set this
# to 0 when workers run as their own processes (see docker-compose.yml):
# WORKER_INLINE=0
#
# Finished films and images are served from data/outputs, which is the
# default and the right one whenever the API and the worker share a disk:
# no network round trip, no expiring links. Set STORAGE_URL *only* for a
# deployment where they are on different hosts. Cloudflare R2 is free up to
# 10 GB with no egress charge. Credentials alone change nothing — this line
# is the switch.
# STORAGE_URL=s3://my-bucket
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_PUBLIC_BASE=https://films.example.com
# S3_REGION=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
#
# Everything above that is a file — films, versions, the SQLite database —
# lives under one directory. Move it (a container volume, a data disk):
# DATA_DIR=/var/lib/storygen
#
# On a server, deploy/backup.sh also copies each night's backup to this
# bucket (same S3/R2 keys as above); deploy/restore.sh bucket brings it back.
# BACKUP_BUCKET=my-bucket
# BACKUP_PREFIX=backups
# BACKUP_KEEP_REMOTE=14

# --- Accounts (M5) -------------------------------------------------
# The first person to open the web UI becomes the administrator. After
# that, open sign-ups are off unless you turn them on:
# ALLOW_SIGNUPS=1
#
# The session cookie is marked Secure automatically when the request
# arrives over HTTPS. Behind a proxy that terminates TLS, force it:
# COOKIE_SECURE=1
#
# The UI is served from the same origin as the API, so no cross-origin
# request is allowed by default. Name the origins if you host the
# frontend separately:
# CORS_ORIGINS=https://app.example.com
#
# Sign in with GitHub (free). Register an OAuth app at GitHub → Settings →
# Developer settings → OAuth Apps, with the redirect URI
#   http://localhost:8000/api/auth/github/callback
# (one app can list up to ten — add https://<your server>/api/auth/github/callback too)
# A GitHub sign-in never joins an existing account by email; an account
# with a password connects GitHub from the top bar while signed in.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Behind a proxy, pin the callback to the URL GitHub was registered with:
# GITHUB_CALLBACK_URL=https://films.example.com/api/auth/github/callback

# --- Real motion (M6) ----------------------------------------------
# Animating a still costs money per clip with every provider that does
# it well, so the chain ends on the offline camera moves and nothing
# here is required.
#
# Veo 3.1 runs through the Gemini API you may already have a key for.
# It is BILLED PER SECOND and is not in the free tier, so it needs this
# second, deliberate opt-in as well as GEMINI_API_KEY:
# VIDEO_BUDGET_OK=1
#
# fal.ai gives about $1 of free trial credit:
# FAL_KEY=
#
# How much larger than the output a camera move is computed at. Higher
# is smoother and slower; 3 is the default and 4 the cap.
# SUPERSAMPLE=3
#
# How many shots render at once. A shot keeps about one core busy, so the
# default is one per core (at most 4, since each holds a large frame in
# memory). Lower it to leave cores free for something else on the machine.
# SHOT_WORKERS=2
