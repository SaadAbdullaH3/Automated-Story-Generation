# HTTPS in front of the app. Caddy obtains and renews the certificate itself
# (Let's Encrypt) for whatever DOMAIN points at this machine — no cron, no
# certbot. WebSocket upgrades (live progress) pass through by default.
{$DOMAIN} {
	# Compress text only. A film is already compressed, and the player asks
	# for byte ranges — compressing those would break seeking.
	encode {
		zstd
		gzip
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type image/svg+xml*
		}
	}

	reverse_proxy api:8000

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}
}
