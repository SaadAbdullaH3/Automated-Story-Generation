# HTTPS in front of the app. Caddy obtains and renews the certificate itself
# (Let's Encrypt) for whatever DOMAIN points at this machine — no cron, no
# certbot. WebSocket upgrades (live progress) pass through by default.
{$DOMAIN} {
	# Compress text only. A film is already compressed, and the player asks
	# for byte ranges — compressing those would break seeking.
	encode {
		zstd
		gzip
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type image/svg+xml*
		}
	}

	reverse_proxy api:8000

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# Without a Cache-Control header browsers guess, and a returning visitor
	# can be shown yesterday's interface after a deploy. Pages are revalidated
	# on every visit (a few bytes when unchanged); Next's build files carry a
	# content hash in their names, so they can be kept for a year. The API,
	# the WebSocket and the films set their own rules.
	@pages not path /_next/static/* /api/* /ws/* /assets/*
	header @pages ?Cache-Control "no-cache"
	header /_next/static/* Cache-Control "public, max-age=31536000, immutable"
}
